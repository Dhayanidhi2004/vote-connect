# Copy to .env and fill in. If DATABASE_URL is unset, a local SQLite file is used.

# --- Supabase (Postgres) -----------------------------------------------------
# Get this from Supabase dashboard -> Project Settings -> Database ->
# "Connection string" -> choose the "Session pooler" URI, then convert the
# scheme from  postgresql://  to  postgresql+pg8000://  (pure-Python driver).
#
# Example (Session pooler, port 5432):
# DATABASE_URL=postgresql+pg8000://postgres.<project-ref>:<YOUR-DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# DATABASE_URL=

# JWT secret for demo sessions (any random string locally)
JWT_SECRET=demo-only-secret-change-me

# Comma-separated allowed CORS origins (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# Gemini API key for AI career guidance and match explanations.
# GEMINI_API_KEY=
# Optional override; default is gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
# Set to false only when local SSL interception breaks Google API calls.
# GEMINI_VERIFY_SSL=true

# Supabase voter-data integration (server-side only).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Set to false only for local environments with broken SSL trust.
# SUPABASE_VERIFY_SSL=false
